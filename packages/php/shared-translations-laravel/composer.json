{
    "name": "ceedcv-maya/shared-translations-laravel",
    "description": "Polymorphic translations for Laravel: a single translations table + HasTranslations trait to store per-locale field values for any model (panel alerts, messages, …).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Maya-AQSS/shared-translations-laravel",
    "support": {
        "issues": "https://github.com/Maya-AQSS/maya_platform/issues",
        "source": "https://github.com/Maya-AQSS/shared-translations-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Maya\\Translations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maya\\Translations\\Providers\\SharedTranslationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "i18n",
        "translations",
        "polymorphic",
        "locale",
        "ceedcv",
        "maya"
    ],
    "authors": [
        {
            "name": "CEEDCV",
            "email": "info@ceedcv.es",
            "homepage": "https://ceedcv.es"
        }
    ]
}
