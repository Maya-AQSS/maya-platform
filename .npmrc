# Link in-workspace packages when their version matches the dependency range.
# This lets us use plain "^0.1.0" instead of "workspace:*" — keeping the same
# package.json contents that external consumers (npm via github:) can resolve.
link-workspace-packages=true
prefer-workspace-packages=true

# Required when consumers install via github: URLs — npm/pnpm runs git-dep
# preparation which requires package-lock or pnpm-lock; we provide pnpm-lock.
